WorldInfo {
  # Agregado: el mundo oficial de Webots para el Mavic 2 Pro real
  # (projects/robots/dji/mavic/worlds/mavic_2_pro.wbt) define este
  # defaultDamping explicitamente. Sin el, Webots NO aplica ningun
  # arrastre/resistencia al movimiento por defecto - una vez que el dron
  # agarra velocidad, nada fisico se le opone salvo lo que el controlador
  # logre corregir activamente con el termino D. Esto es probablemente la
  # causa principal de que pequeños errores de despegue se conviertan en
  # ascensos que ya no se pueden frenar a tiempo.
  defaultDamping Damping {
    linear 0.5
    angular 0.5
  }
}
