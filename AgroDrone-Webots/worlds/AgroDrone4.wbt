# ── Gotas de agua (efecto visual de riego) ──────────────────────────────────
# 10 esferas pequeñas y translúcidas, sin física ni boundingObject (solo
# decorativas). El controlador (Supervisor) las mueve cada paso de
# simulación via DEF, animándolas en caída libre cuando el dron está
# REGANDO. Empiezan "aparcadas" muy por debajo del mapa (z = -50) para que
# no se vean hasta que el controlador las active.
DEF GOTA_0 Solid {
  translation 0 0 -50
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.35 0.65 1
        transparency 0.25
        roughness 0.25
        metalness 0
      }
      geometry Sphere {
        radius 0.025
        subdivision 1
      }
    }
  ]
  name "gota_0"
}
DEF GOTA_1 Solid {
  translation 0 0 -50
  children [
    Shape {
      appearance PBRAppearance {
